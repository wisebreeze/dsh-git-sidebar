{
  "name": "dsh-browser-plus",
  "version": "0.1.0",
  "description": "为 DeepSeek Harness Web 添加侧边栏浏览器，输入框智能识别：网址直接访问，非网址走 Bing 搜索。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "web",
    "browser",
    "sidebar",
    "bing",
    "search"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": false
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  }
}
