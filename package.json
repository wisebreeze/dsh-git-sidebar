{
  "name": "dsh-git-sidebar",
  "version": "0.1.0",
  "description": "为 DeepSeek Harness Web 侧边栏添加 Git 卡片（排在浏览器下方），点进去顶部显示当前仓库的 git 更改。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "web",
    "git",
    "sidebar",
    "vcs"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [],
      "immediately": false
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "react": "^18.2.0"
  }
}
